HOST=127.0.0.1
PORT=8000
LINGJING_API_KEY=change-me
LINGJING_ADMIN_PASSWORD=
SESSION_MODE=browser-state
LINGJING_STORAGE_STATE=./data/auth/storage-state.json
LINGJING_COOKIE_FILE=./data/auth/cookie.txt
LINGJING_SESSION_PROFILE=./data/auth/session-profile.json
LINGJING_DATA_DIRECTORY=./data
DATABASE_DRIVER=sqlite
# DATABASE_URL=postgres://user:password@postgres:5432/lingjing
DB_PATH=./data/lingjing.db
OBJECT_STORE=local
# S3-compatible mode: set OBJECT_STORE=s3 plus credentials through standard AWS env vars.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=lingjing
S3_FORCE_PATH_STYLE=false
LINGJING_MAX_CONCURRENCY=5
MODEL_CACHE_TTL_MS=300000
ASSET_DISCOVERY_TIMEOUT_MS=60000
UNKNOWN_CAPACITY_HOLD_MS=900000
TASK_POLL_INTERVAL_MS=5000
IMAGE_WAIT_TIMEOUT_MS=300000
VIDEO_WAIT_TIMEOUT_MS=900000
MAX_IMAGE_BYTES=20971520
MAX_VIDEO_BYTES=209715200
OUTPUT_RETENTION_MS=604800000
JSON_BODY_LIMIT_BYTES=33554432
MAX_REQUEST_MEDIA_BYTES=230686720
MAX_TEMP_BYTES=1073741824
MAX_QUEUED_REQUESTS=20
# 当前 Local 模式将输入资产持久化到 ${LINGJING_DATA_DIRECTORY}/objects。
# Webhook 投递强制 HTTPS、公网 DNS、固定解析地址、禁止重定向，单次超时 10 秒。
# Production PostgreSQL/Redis/S3 适配器尚未启用；当前权威存储仍为 SQLite + 本地对象目录。
LOG_LEVEL=info
