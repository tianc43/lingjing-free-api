LINGJING_API_KEY=change-me
LINGJING_ADMIN_PASSWORD=change-me
POSTGRES_USER=lingjing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lingjing
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379
# Keep sqlite for the initial boot/migration; switch to postgres only after offline validation.
DATABASE_DRIVER=sqlite
DATABASE_URL=postgres://lingjing:change-me@postgres:5432/lingjing
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=lingjing
S3_PREFIX=lingjing
LOG_LEVEL=info
