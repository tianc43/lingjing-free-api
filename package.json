{
  "name": "lingjing-free-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "login": "tsx src/cli/login.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live",
    "test:live:video": "vitest run tests/live/video.live.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.10.0",
    "pino": "^10.3.1",
    "tough-cookie": "^6.0.2",
    "undici": "^7.28.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.7"
  }
}
