{
  "name": "lingjing-free-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build:server": "tsc -p tsconfig.build.json",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build": "npm run build:server && npm run build:admin",
    "check": "npm run lint && npm run typecheck && npm test",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "login": "node --env-file=.env --import tsx src/cli/login.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "test": "vitest run --exclude tests/live/**",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:live:video": "vitest run --config vitest.live.config.ts tests/live/video.live.test.ts",
    "test:minio": "tsx tests/integration/s3-minio.integration.ts",
    "migrate:postgres": "tsx src/cli/migrate-postgres.ts",
    "audit:objects": "tsx src/cli/audit-objects.ts",
    "audit:postgres-objects": "tsx src/cli/audit-postgres-objects.ts",
    "test:browser:sqlite": "playwright test tests/browser/admin.browser.test.ts --reporter=line",
    "test:browser:postgres": "pwsh -NoProfile -File tests/fixtures/run-postgres-browser.ps1",
    "test:browser": "npm run test:browser:sqlite && npm run test:browser:postgres",
    "capture:protocol": "tsx src/cli/capture-protocol.ts",
    "inspect:video-catalog": "node --env-file=.env --import tsx src/cli/inspect-video-catalog.ts",
    "backup:local": "tsx src/cli/backup-local.ts",
    "live:preflight": "node --env-file=.env --import tsx src/cli/live-preflight.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.10.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^5.12.1",
    "tough-cookie": "^6.0.2",
    "undici": "^7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
